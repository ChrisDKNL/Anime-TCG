# Serves the Vite build from /srv on an unprivileged port. TLS terminates at
# the owner's reverse proxy or Cloudflare Tunnel, so this server speaks plain
# HTTP, sets no HSTS (the proxy owns that header) and never binds 80/443.
{
	admin off
	auto_https off
	servers {
		# Only the owner's host proxy or tunnel can connect (the publish is
		# loopback-only), and both live in private ranges, so their
		# X-Forwarded-For is believed and the real client address reaches the
		# api; without this Caddy would replace the header with the Docker
		# gateway address and the api's rate limiter would see one client.
		# Behind Cloudflare Tunnel keep this line; the api picks the entry
		# Cloudflare appended, so a forged leftmost one is harmless. Add
		# `client_ip_headers CF-Connecting-IP` next to it only for Caddy's own
		# {client_ip} and access logs (docs/04-deployment.md).
		trusted_proxies static private_ranges
		# A client that opens a connection and stalls is cut off here, before
		# it can hold a socket to the api.
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		# style-src is strict on purpose. React applies the `style` prop through
		# the CSSOM (element.style.setProperty), which CSP does not govern, and
		# the production build links its CSS via <link> with no inline <style>.
		# The dev server, which does inject <style>, never runs behind this
		# Caddyfile. Revisit this if SSR or a `?inline` CSS import is ever
		# introduced: both would need inline style allowances (a nonce or hash).
		# img-src and connect-src list the only remote hosts the app talks to
		# (src/lib/anilist.ts).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://s4.anilist.co; connect-src 'self' https://graphql.anilist.co; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# A version banner only helps someone probing the server. The Via line
		# is Caddy's own, added by reverse_proxy after the backend's headers, so
		# it has to go here rather than in a `header_down` of that block.
		-Server
		-Via
	}

	# Liveness probe for the image HEALTHCHECK and the CI smoke test.
	handle /healthz {
		respond "ok" 200
	}

	# The api owns /api itself and everything under it. Caddy only forwards,
	# so the browser sees one origin and connect-src stays 'self'; an unknown
	# api path gets the api's JSON 404, never the app shell. `api` is a network
	# alias compose.yml gives the api service of each profile; the api's own
	# /healthz is not under /api and stays reachable only inside the network.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000
	}

	# Vite content-hashes everything under /assets, so a file at a given name
	# never changes and can be cached forever; a new build gets new names. A
	# missing asset is a plain 404, never index.html served as a script: a
	# page whose chunk a deploy replaced fails loudly instead of blankly. The
	# 404 is a response rather than file_server's error, because Caddy's error
	# path drops the site headers above (and lets `Server` through), and it is
	# not given the year-long cache that only an existing file has earned.
	handle /assets/* {
		@asset file
		@missing not file
		header @asset Cache-Control "public, max-age=31536000, immutable"
		respond @missing 404
		file_server
	}

	# Everything else is the app: every path that is not a file in the build
	# gets index.html with 200, and the app's router decides what it is, its
	# not-found page included (docs/design/navigation-and-landing.md §3.12).
	# No route list lives here, so a new page never needs a change in this
	# file. index.html is revalidated on every load so a deploy is seen at once.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
