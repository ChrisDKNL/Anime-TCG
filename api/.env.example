# Copy to api/.env.local (gitignored) for `npm run dev`; node loads it with
# --env-file-if-exists. Compose does not read this file: the acceptance and
# production stacks take their values from the root .env file instead.
NODE_ENV=development
LOG_LEVEL=debug
HOST=127.0.0.1
PORT=3000
# The `dev`/`test` compose profile publishes Postgres on loopback with these credentials.
DATABASE_URL=postgres://anime:anime@127.0.0.1:5432/anime
# At least 32 bytes. Generate one: openssl rand -base64 48
# The api refuses to start with this placeholder.
SESSION_SECRET=replace-with-32-plus-random-bytes-see-api/.env.example
API_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
