{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "shared-alias.ts",
    "font-licenses.ts",
    "e2e/**/*.ts",
    "src/test/fixtures.ts",
    "src/test/collectionFixtures.ts",
    "src/test/copyWords.ts",
    "src/types.ts"
  ],
  "references": [{ "path": "../shared" }]
}
