{
  "name": "@anime-tcg/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API contract schemas and game constants shared by web/ and api/",
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./economy": {
      "types": "./dist/economy.d.ts",
      "default": "./dist/economy.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./rarity": {
      "types": "./dist/rarity.d.ts",
      "default": "./dist/rarity.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p test",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  }
}
