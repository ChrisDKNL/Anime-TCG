# Compose variables for the acceptance and production profiles. Copy to a
# gitignored file (for example .env.acceptance.local; `.env.*` and `*.local`
# are ignored) and pass it with `docker compose --env-file <file> ...`.
# Compose reads it; it never enters an image or the repo.
TAG=local
ACCEPTANCE_PORT=8080
PRODUCTION_PORT=8081
# Password of the `anime` database role. Used only inside the compose network.
POSTGRES_PASSWORD=replace-with-a-random-password
# At least 32 random bytes; the api refuses this placeholder. Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-32-plus-random-bytes-see-api/.env.example
# The origin browsers use for the site, exactly as they send it in the Origin header.
# Acceptance on this host: http://127.0.0.1:8080. Production: the proxy's or tunnel's https origin.
WEB_ORIGIN=http://127.0.0.1:8080
LOG_LEVEL=info
# Loopback port of the `dev`/`test` profile database.
DEV_DB_PORT=5432
